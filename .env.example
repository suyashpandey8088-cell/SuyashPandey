# ---------------------------------------------------------------------------
# Public Supabase project values (safe to expose in the browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Server-only secrets. NEVER prefix these with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret required by the scheduled-publishing endpoint.
# Vercel Cron sends it automatically via `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=generate-with-openssl-rand-hex-32

# Canonical site origin, used for metadata, Open Graph and share links.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: comma separated emails allowed to bootstrap the first admin.
ADMIN_BOOTSTRAP_EMAILS=suyashpandey8088@gmail.com

# Editorial timezone for the public site (IANA name).
NEXT_PUBLIC_SITE_TIMEZONE=Asia/Kolkata
